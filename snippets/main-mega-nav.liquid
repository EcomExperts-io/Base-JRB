<style>
    .mega-menu-wrap.cs-container ul {
        padding: 0;
        list-style: none;
        color: black;
        display: flex;
        justify-content: center;
    }
    .mega-menu-wrap.cs-container ul li > a {
        text-decoration: auto;
        color: black;
        letter-spacing: 0;
        height: 55px;
        display: flex;
        align-items: center;
        padding: 0px 30px;
    }
    .mega-menu-wrap.cs-container ul li:first-child a {
        padding-left: 0px;
    }
    .mega-menu-wrap.cs-container ul li:last-child a {
        padding-right: 0px;
    }
    .mega-menu {
        width: 100%;
        min-width: unset;
        padding: 30px 45px;
        box-shadow: 0 2px 8px #93939340;
        transition: unset;
        position: absolute;
        background: white;
        left: 0;
        display: none;
    }
    .mega-menu-inner {
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 60px;
    }
    .mega-menu-image-wrap {
        max-width: 604px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 24px;
    }
    .mega-menu-image {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
    }
    .mega-menu-image img{
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
    .mega-menu-image > a {
        padding: 0px;
        display: block !important;
    }
    .mega-text-wrap > a {
        font-size: 16px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #000;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 2px;
        font-family: ArticulatCF, GeogrotesqueCondBoldWeb, Arial Black, Impact, sans-serif;
        line-height: 1.4;
        word-wrap: break-word;
        -webkit-hyphens: auto;
        hyphens: auto;
    }
    .mega-text-desc {
        margin-top: 8px;
        color: #5a5a5a;
        font-size: 15px;
        line-height: 22px;
        letter-spacing: .4px;
        font-weight: 325;
        font-family: RingsideWideWeb, Helvetica, Arial, sans-serif;
    }
    .megamenu-nav-heading span {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #000;
        text-underline-offset: 3px;
        font-family: GeogrotesqueCondBoldWeb, Arial Black, Impact, sans-serif;
        line-height: 1;
    }
    .megamenu-nav-items {
        display: flex;
        gap: 40px;
        margin-top: 26px;
    }
    ul.megamenu-nav-item-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    li.megamenu-nav-item-list-item > a {
        display: flex;
        gap: 12px;
        align-items: center;
        white-space: normal;
        font-size: 15px;
        color: #000;
        letter-spacing: .1px;
        font-weight: 325;
        padding: unset !important;
        height: auto !important;
    }
    .megamenu-nav-item-list li.megamenu-nav-item-list-item:last-child{
        padding-bottom: 10px;
    }
    .megamenu-nav-item-image img {
        width: 52px;
        height: 52px;
        display: block;
        object-fit: cover;
    }
    .megamenu-nav-item-image {
        flex: 0 0 auto;
    }
    .megamenu-nav-item-content-title {
        font-family: articulat-cf;
        color: #000;
        font-weight: 800;
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: .1px;
        line-height: 22px;
    }
    .megamenu-nav-item-content-row {
        margin-top: 4px;
        display: flex;
        flex-flow: row nowrap;
        justify-content: flex-start;
        {% comment %} align-items: center; {% endcomment %}
        gap: 8px;
        width: 100%;
    }
    .megamenu-nav-item-content-review {
        height: 13px;
        padding-top: 1px;
    }
    .megamenu-nav-item-content-review {
        display: flex;
    }
    .megamenu-nav-item-content-tag {
        line-height: 16px;
        font-size: 13px;
        font-weight: 550;
        letter-spacing: .4px;
        color: #ff2e92;
        font-family: BaseMonoWideWeb, Courier, Courier New, sans-serif;
        text-transform: uppercase;
        margin-top: 0px;
    }
    .megamenu-nav-item-list > ul {
        display: flex;
        flex-direction: column;
    }
    .megamenu-nav-item.megamenu-nav-item--right ul li a {
        color: #000;
        font-size: 15px;
        letter-spacing: .1px;
        line-height: 1;
        display: block;
        font-family: RingsideWideWeb, Helvetica, Arial, sans-serif;
        text-transform: capitalize;
        white-space: nowrap;
        text-decoration-color: #000;
        text-decoration-thickness: auto;
        height: unset !important;
        padding: 0px !important; 
    }
    .megamenu-nav-item.megamenu-nav-item--right ul li {
        padding: 8px 0;
    }
    .megamenu-nav-item.megamenu-nav-item--right ul li.shop-all-list a {
        text-decoration: underline !important;
        text-underline-offset: 3px;
    }
    .mega-menu-wrap{
        position: relative;
    }
    .mega-menu-wrap:before {
        position: absolute;
        content: "";
        width: 100%;
        height: 100%;
        z-index: 8;
        box-shadow: 0 2px 8px #93939340;
        pointer-events: none;
        left: 0;
    }
    .megamenu-nav-item.megamenu-nav-item--left {
        width: 100%;
        max-width: 290px;
        min-width: 290px;
    }
    .megamenu-nav-item.megamenu-nav-item--right {
        width: 100%;
        max-width: 242px;
        min-width: 242px;
    }
    .megamenu-nav-blocks a {
        height: unset !important;
    }
    .megamenu-nav-blocks li.megamenu-nav-item-list-item {
        line-height: 34px;
    }
    .megamenu-nav-blocks ul.megamenu-nav-item-list {
        gap: unset;
    }
    @media screen and (max-width: 1200px) {
        .megamenu-nav-item.megamenu-nav-item--left {
            width: 100%;
            max-width: 240px;
            min-width: 240px;
        }
        .megamenu-nav-item.megamenu-nav-item--right {
            width: 100%;
            max-width: 200px;
            min-width: 200px;
        }
        .mega-menu-inner{
            gap: 30px;
        }
        .mega-menu-image-wrap {
            gap: 15px;
            align-items: flex-start;
        }
        .megamenu-nav-items {
            gap: 20px;
        }
        .megamenu-nav-item-content-title{
            font-size: 15px;
        }
    }
    @media screen and (min-width: 1024px) {
        .mega-menu-image > a {
            width: 200px;
            height: 200px !important;
        }
    }
    @media screen and (min-width: 1120px) {
        .mega-menu-image > a {
            width: 250px;
            height: 250px !important;
        }
    }
    @media screen and (min-width: 1290px) {
        .mega-menu-image > a {
            width: 290px;
            height: 290px !important;
        }
    }
    @media screen and (max-width: 1124px) {
        .mega-menu-image-wrap{
            max-width: unset;
        }
    }
    
    
</style>
<div class="mega-menu-wrap cs-container font-ringside">
    {% if section.settings.megamenu != blank %}
    <ul>
        {% for link in linklists[section.settings.megamenu].links %}
        <li>
            <a href="{{ link.url }}">
                <span>
                    {{ link.title }}
                </span>
            </a>
            {% for block in section.blocks %}
                {% if block.settings.mname == link.title %}
                    {% render 'mega-menu', block: block, link: link %}
                {% endif %}
            {% endfor %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</div>