{%- comment -%} Horizontal Infinite Slider JavaScript {%- endcomment -%}
<script>
  (function() {
    const sliders = document.querySelectorAll('.js__header-promo-slider');
    
    sliders.forEach(function(wrapper) {
      const slider = wrapper.querySelector('.header-promo__slider');
      const slides = Array.from(wrapper.querySelectorAll('.header-promo-slide'));
      const prevBtn = wrapper.querySelector('.header-promo__arrow--prev');
      const nextBtn = wrapper.querySelector('.header-promo__arrow--next');
      const delay = (parseInt(wrapper.dataset.delay) || 4) * 1000;
      
      if (!slider || slides.length <= 1) return;
      
      const totalSlides = slides.length;
      let currentIndex = 0;
      let autoplayInterval = null;
      let isTransitioning = false;
      
      // Clone first and last slides for infinite effect
      const firstClone = slides[0].cloneNode(true);
      const lastClone = slides[totalSlides - 1].cloneNode(true);
      firstClone.classList.add('is-clone');
      lastClone.classList.add('is-clone');
      
      slider.appendChild(firstClone);
      slider.insertBefore(lastClone, slides[0]);
      
      // Start at position 1 (after the prepended clone)
      currentIndex = 1;
      slider.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      
      function goToSlide(index, animate) {
        if (isTransitioning) return;
        
        if (animate !== false) {
          slider.classList.add('is-animating');
          isTransitioning = true;
        }
        
        currentIndex = index;
        slider.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      }
      
      function handleTransitionEnd() {
        slider.classList.remove('is-animating');
        isTransitioning = false;
        
        // If at clone, jump to real slide instantly
        if (currentIndex === 0) {
          // At last clone (before first), jump to real last
          currentIndex = totalSlides;
          slider.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
        } else if (currentIndex === totalSlides + 1) {
          // At first clone (after last), jump to real first
          currentIndex = 1;
          slider.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
        }
      }
      
      slider.addEventListener('transitionend', handleTransitionEnd);
      
      function nextSlide() {
        goToSlide(currentIndex + 1);
      }
      
      function prevSlide() {
        goToSlide(currentIndex - 1);
      }
      
      function startAutoplay() {
        stopAutoplay();
        autoplayInterval = setInterval(nextSlide, delay);
      }
      
      function stopAutoplay() {
        if (autoplayInterval) {
          clearInterval(autoplayInterval);
          autoplayInterval = null;
        }
      }
      
      // Arrow button clicks
      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          prevSlide();
          startAutoplay();
        });
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          nextSlide();
          startAutoplay();
        });
      }
      
      // Pause on hover
      wrapper.addEventListener('mouseenter', stopAutoplay);
      wrapper.addEventListener('mouseleave', startAutoplay);
      
      // Start autoplay
      startAutoplay();
    });
  })();
</script>
