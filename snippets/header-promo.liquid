    class="header-promo {% unless one_aud_slide_only %}header-promo--has-slides js__header-promo-slider{% endunless %}"
    data-delay="{{ section.settings.header_promo_delay_aud }}"
    style="color: {{ section.settings.header_promo_color_aud }}; background-color: {{ section.settings.header_promo_bgcolor_aud }}"
  >
    <div class="header-promo__outer">
      {% if section.settings.header_promo_left_link_text != blank and section.settings.header_promo_left_link_url != blank %}
        <a href="{{ section.settings.header_promo_left_link_url }}" class="header-promo__edge-link header-promo__edge-link--left">
          {{ section.settings.header_promo_left_link_text }}
        </a>
      {% endif %}
      <div class="header-promo__container">
        <button type="button" class="header-promo__arrow header-promo__arrow--prev" aria-label="Previous">
          <svg width="8" height="11" viewBox="0 0 8 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.78101 0.384033L0.781006 5.38403L6.78101 10.384" stroke="currentColor"/>
          </svg>
        </button>
        <div class="header-promo__viewport">
          <div class="header-promo__slider">
            {% if section.settings.header_promo_richtext_aud_01 != blank %}
              <div class="header-promo-slide">
                <span class="header-promo-slide__content">
                  {% if section.settings.header_promo_richtext_aud_01_mobile != blank %}
                    <span class="mobile_promo">{{ section.settings.header_promo_richtext_aud_01_mobile }}</span>
                  {% endif %}
                  <span class="desktop_promo">{{ section.settings.header_promo_richtext_aud_01 }}</span>
                </span>
              </div>
            {% endif %}
            {% if section.settings.header_promo_richtext_aud_02 != blank %}
              <div class="header-promo-slide">
                <span class="header-promo-slide__content">
                  {% if section.settings.header_promo_richtext_aud_02_mobile != blank %}
                    <span class="mobile_promo">{{ section.settings.header_promo_richtext_aud_02_mobile }}</span>
                  {% endif %}
                  <span class="desktop_promo">{{ section.settings.header_promo_richtext_aud_02 }}</span>
                </span>
              </div>
            {% endif %}
            {% if section.settings.header_promo_richtext_aud_03 != blank %}
              <div class="header-promo-slide">
                <span class="header-promo-slide__content">
                  {% if section.settings.header_promo_richtext_aud_03_mobile != blank %}
                    <span class="mobile_promo">{{ section.settings.header_promo_richtext_aud_03_mobile }}</span>
                  {% endif %}
                  <span class="desktop_promo">{{ section.settings.header_promo_richtext_aud_03 }}</span>
                </span>
              </div>
            {% endif %}
          </div>
        </div>
        <button type="button" class="header-promo__arrow header-promo__arrow--next" aria-label="Next">
          <svg width="8" height="11" viewBox="0 0 8 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.320068 0.384033L6.32007 5.38403L0.320068 10.384" stroke="currentColor"/>
          </svg>
        </button>
      </div>
      {% if section.settings.header_promo_right_link_text != blank and section.settings.header_promo_right_link_url != blank %}
        <a href="{{ section.settings.header_promo_right_link_url }}" class="header-promo__edge-link header-promo__edge-link--right">
          {{ section.settings.header_promo_right_link_text }}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}

