{%- comment -%} Horizontal Infinite Slider Styles {%- endcomment -%}
<style>
  .header-promo {
    position: relative;
    overflow: hidden;
  }
  .header-promo__outer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 45px;
    box-sizing: border-box;
  }
  .header-promo__edge-link {
    color: inherit;
    text-decoration: underline;
    font-size: 15px;
    white-space: nowrap;
    opacity: 0.9;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }
  .header-promo__edge-link.header-promo__edge-link--left {
    text-decoration: none;
  }

  
  .header-promo__edge-link:hover {
    opacity: 1;
  }
  .header-promo__edge-link--left {
    margin-right: auto;
  }
  .header-promo__edge-link--right {
    margin-left: auto;
  }
  .header-promo__container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .header-promo__viewport {
    overflow: hidden;
    flex: 0 1 auto;
    /* max-width: min-content; */
  }
  .header-promo__slider {
    display: flex;
    width: 100%;
  }
  .header-promo__slider.is-animating {
    transition: transform 0.4s ease-in-out;
  }
  .header-promo-slide {
    min-width: 100%;
    width: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .header-promo__arrow {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .header-promo__arrow.header-promo__arrow--prev {
    left: 45px
  }

  .header-promo__arrow.header-promo__arrow--next{
    right: 45px;
  }

  .header-promo__arrow:hover {
    opacity: 1;
  }
  .header-promo__arrow svg {
    display: block;
    width: 10px;
    height: 13px;
    color: {{ section.settings.header_promo_color_usa }};
  }
  /* Hide arrows when only one slide */
  .header-promo:not(.header-promo--has-slides) .header-promo__arrow {
    display: none;
  }
  @media screen and (max-width: 767px) {
    .header-promo__outer {
      padding: 0 10px;
    }
    .header-promo__edge-link {
      font-size: 10px;
    }
    .header-promo__viewport {
      max-width: calc(100% - 40px);
    }
    .header-promo__arrow {
      display: none;
    }
  }
</style>

{% if currency_code == 'USD' %}
  {%- comment -%} Free Shipping Info Update on Header Promo {%- endcomment -%}

  {%- comment -%} Intelligems Test Groups {%- endcomment -%}
  {%- assign variant1 = 'eb06c9398187' -%}
  {%- assign variant2 = 'd2533a399546' -%}
  {%- assign variant3 = '8e5c08b0fba3' -%}
  {%- assign variant4 = '649cd904870b' -%}

  {%- if cart.attributes and cart.attributes.igTestGroups -%}
    {%- assign intelligems_variant = cart.attributes.igTestGroups | default: '' | downcase | strip -%}
  {%- endif -%}

  {%- if intelligems_variant contains variant1 -%}
    {%- assign us_shipping_threshold = section.settings.cart_free_shipping_amount_v1 | default: section.settings.cart_free_shipping_amount -%}
  {%- elsif intelligems_variant contains variant2 -%}
    {%- assign us_shipping_threshold = section.settings.cart_free_shipping_amount_v2 | default: section.settings.cart_free_shipping_amount -%}
  {%- elsif intelligems_variant contains variant3 -%}
    {%- assign us_shipping_threshold = section.settings.cart_free_shipping_amount_v3 | default: section.settings.cart_free_shipping_amount -%}
  {%- elsif intelligems_variant contains variant4 -%}
    {%- assign us_shipping_threshold = section.settings.cart_free_shipping_amount_v4 | default: section.settings.cart_free_shipping_amount -%}
  {%- else -%}
    {%- assign us_shipping_threshold = section.settings.cart_free_shipping_amount -%}
  {%- endif -%}

  {%- if us_shipping_threshold != blank and us_shipping_threshold != '' -%}
    {%- assign promo_02 = section.settings.header_promo_richtext_usa_02 -%}
    {%- if promo_02 != blank -%}
      {%- assign promo_02_lower = promo_02 | downcase -%}
      {%- if promo_02_lower contains 'free shipping' and promo_02_lower contains '$' -%}
        {%- assign promo_02 = 'Free shipping on US orders over $' | append: us_shipping_threshold -%}
      {%- endif -%}
    {%- endif -%}
    
    {%- assign promo_02m = section.settings.header_promo_richtext_usa_02_mobile -%}
    {%- if promo_02m != blank -%}
      {%- assign promo_02m_lower = promo_02m | downcase -%}
      {%- if promo_02m_lower contains 'free shipping' and promo_02m_lower contains '$' -%}
        {%- assign promo_02m = 'Free shipping on US orders over $' | append: us_shipping_threshold -%}
      {%- endif -%}
    {%- endif -%}
  {%- else -%}
    {%- assign promo_02 = section.settings.header_promo_richtext_usa_02 -%}
    {%- assign promo_02m = section.settings.header_promo_richtext_usa_02_mobile -%}
  {%- endif -%}

  <div
    class="header-promo {% unless one_usd_slide_only %}header-promo--has-slides js__header-promo-slider{% endunless %}"
    data-delay="{{ section.settings.header_promo_delay_usa }}"
    data-region="{{ currency_code }}"
    data-amt-v1="{{ section.settings.cart_free_shipping_amount_v1 | default: section.settings.cart_free_shipping_amount }}"
    data-amt-v2="{{ section.settings.cart_free_shipping_amount_v2 | default: section.settings.cart_free_shipping_amount }}"
    data-amt-v3="{{ section.settings.cart_free_shipping_amount_v3 | default: section.settings.cart_free_shipping_amount }}"
    data-amt-v4="{{ section.settings.cart_free_shipping_amount_v4 | default: section.settings.cart_free_shipping_amount }}"
    style="color: {{ section.settings.header_promo_color_usa }}; background-color: {{ section.settings.header_promo_bgcolor_usa }}"
  >
    <div class="header-promo__outer">
      {% if section.settings.header_promo_left_link_text != blank and section.settings.header_promo_left_link_url != blank %}
        <a href="{{ section.settings.header_promo_left_link_url }}" class="header-promo__edge-link header-promo__edge-link--left">
          {{ section.settings.header_promo_left_link_text }}
        </a>
      {% endif %}
      <div class="header-promo__container">
        <button type="button" class="header-promo__arrow header-promo__arrow--prev" aria-label="Previous">
          <svg width="8" height="11" viewBox="0 0 8 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.78101 0.384033L0.781006 5.38403L6.78101 10.384" stroke="currentColor"/>
          </svg>
        </button>
        <div class="header-promo__viewport">
          <div class="header-promo__slider">
            {% if section.settings.header_promo_richtext_usa_01 != blank %}
              <div class="header-promo-slide">
                <span class="header-promo-slide__content">
                  {% if section.settings.header_promo_richtext_usa_01_mobile != blank %}
                    <span class="mobile_promo">{{ section.settings.header_promo_richtext_usa_01_mobile }}</span>
                  {% endif %}
                  <span class="desktop_promo">{{ section.settings.header_promo_richtext_usa_01 }}</span>
                </span>
              </div>
            {% endif %}

            {% comment %} 3. TARGET THIS SLIDE WITH JS CLASS {% endcomment %}
            {% if promo_02 != blank %}
              <div class="header-promo-slide">
                {% if promo_02m != blank %}
                  <span class="mobile_promo js-promo-text-target">{{ promo_02m }}</span>
                {% endif %}
                <span class="desktop_promo js-promo-text-target">{{ promo_02 }}</span>
              </div>
            {% endif %}

            {% if section.settings.header_promo_richtext_usa_03 != blank %}
              <div class="header-promo-slide">
                <span class="header-promo-slide__content">
                  {% if section.settings.header_promo_richtext_usa_03_mobile != blank %}
                    <span class="mobile_promo">{{ section.settings.header_promo_richtext_usa_03_mobile }}</span>
                  {% endif %}
                  <span class="desktop_promo">{{ section.settings.header_promo_richtext_usa_03 }}</span>
                </span>
              </div>
            {% endif %}
          </div>
        </div>
        <button type="button" class="header-promo__arrow header-promo__arrow--next" aria-label="Next">
          <svg width="8" height="11" viewBox="0 0 8 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.320068 0.384033L6.32007 5.38403L0.320068 10.384" stroke="currentColor"/>
          </svg>
        </button>
      </div>
      {% if section.settings.header_promo_right_link_text != blank and section.settings.header_promo_right_link_url != blank %}
        <a href="{{ section.settings.header_promo_right_link_url }}" class="header-promo__edge-link header-promo__edge-link--right">
          {{ section.settings.header_promo_right_link_text }}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}

