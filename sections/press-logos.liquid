<style>
    .press-logos__logo {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        box-sizing: border-box;
    }
    .press-logos__inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    @media (min-width: 700px) {
        .press-logos__inner {
            justify-content: space-evenly;
            height: 106px;
        }
    }
    @media (max-width: 1024px) {
        .press-logos__logo {
            height: 100%;
        }
        .press-logos__logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            max-height: 26px;
        }
    }
    /* Visibility Controls */
    @media (min-width: 768px) {
        .hide-desktop-logos {
            display: none !important;
        }
    }

    @media (max-width: 767px) {
        .hide-mobile-logos {
            display: none !important;
        }
    }
    @media (max-width: 700px) {
        #shopify-section-{{section.id }} .press-logos__logo {
            width: calc(100% / {{ section.settings.logos_per_row_mobile }});
        }
        .press-logos__inner {
            padding: 24px 0;
            flex-wrap: wrap;
            row-gap: 26px;
        }
    }
</style>

{%- assign show_desktop = section.settings.show_desktop -%}
{%- assign show_mobile = section.settings.show_mobile -%}

<div
  id="{{ section.settings.section_id }}"
  class="press-logos {% unless show_desktop %}hide-desktop-logos{% endunless %} {% unless show_mobile %}hide-mobile-logos{% endunless %}"
  style="background: {{ section.settings.bg_color }}"
>
  <div class="press-logos__inner">
    {% for block in section.blocks %}
      <div class="press-logos__logo">
        <img
          src="{{ block.settings.logo | img_url: 'x26' }}"
          srcset="{{ block.settings.logo | img_url: 'x52' }} 2x"
          alt="{{ block.settings.logo.alt }}"
          height="26"
          {% if template contains 'index' %}
            loading="lazy"
          {% endif %}
        >
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Press Logos",
  "tag": "section",
  "class": "press-logos__section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Visibility Settings"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Display on Desktop",
      "default": false,
      "info": "Show this section on desktop devices (768px and above)"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Display on Mobile",
      "default": true,
      "info": "Show this section on mobile devices (below 768px)"
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Used to create a permalink to the section. Must be unique to the section, all lower-case, with hyphens instead of spaces.",
      "default": "press"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "logos_per_row_mobile",
      "label": "Logos per row on mobile",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [{ "name": "Press Logos" }]
}
{% endschema %}
