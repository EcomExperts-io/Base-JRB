<style>
    .header-promo.js__header-promo-wrapper {
  min-height: 35px;
  z-index: 11;
  transition: height 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  width: 100%;
  height: 100%;
}
.header-promo.js__header-promo-wrapper .header-promo-slide {
  line-height: 21px;
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(100%);
  padding: 0;
  transition: transform 900ms ease;
  max-width: 90%;
  left: 5%;
}
.header-promo.js__header-promo-wrapper .header-promo-slide.active {
  animation: promo-opacity 800ms ease 0s 1 normal forwards;
  animation-delay: 3.2s;
  opacity: 1;
  transform: translateY(0);
}
.header-promo {
  background: inherit;
  color: inherit;
  font-family: "articulat-cf", sans-serif;
  font-size: 13px;
  overflow: hidden;
  position: relative;
  text-align: center;
  z-index: 1;
  font-weight: 400;
}
.header-promo .mobile_promo {
  display: none;
}
@media screen and (max-width: 768px) {
  .header-promo .mobile_promo {
    display: block;
  }
  .header-promo .mobile_promo + .desktop_promo {
    display: none;
  }
}
.header-promo .header-promo-slide {
  line-height: 21px;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 7px;
  letter-spacing: 0.4px;
}
@media screen and (max-width: 393px) {
  .header-promo .header-promo-slide {
    line-height: 120% !important;
    padding-block: 9.4px;
    letter-spacing: 0;
  }
}
.header-promo .header-promo-slide em {
  text-decoration: underline;
}
.header-promo .header-promo-slide strong {
  font-weight: 700;
}
.header-promo .header-promo-slide a {
  text-decoration: underline;
  color: {{ section.settings.header_promo_color_usa }};
  transition: 0.3s;
}
.header-promo .header-promo-slide a:hover {
  color: var(--primary-color);
}
@media screen and (min-width: 1024px) {
  .header-promo {
    font-size: 15px;
  }
}
.header-promo__inner:not(:empty) {
  display: block;
  padding: 7px 40px;
}
@keyframes promo-opacity {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
    .header-promo__arrow.header-promo__arrow--next {
        opacity: 1;
    }
    .header-promo__arrow.header-promo__arrow--prev {
        opacity: 1;
    }
</style>
<div class="announcement-wrapper">
    {%- assign currency_code = localization.country.currency.iso_code -%}
  {%- case currency_code -%}
    {%- when 'USD' -%}
      {%- if section.settings.enable_header_promo_usa -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'CAD' -%}
      {%- if section.settings.enable_header_promo_cad -%}
        {% render 'header-promo', currency_code: currency_code, section: section %}
      {%- endif -%}
    {%- when 'GBP' -%}
      {%- if section.settings.enable_header_promo_uk -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'EUR' -%}
      {%- if section.settings.enable_header_promo_eur -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'BGN' -%}
      {%- if section.settings.enable_header_promo_bul -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'CZK' -%}
      {%- if section.settings.enable_header_promo_cr -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'DKK' -%}
      {%- if section.settings.enable_header_promo_den -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'HUF' -%}
      {%- if section.settings.enable_header_promo_hun -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'PLN' -%}
      {%- if section.settings.enable_header_promo_pol -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'RON' -%}
      {%- if section.settings.enable_header_promo_rom -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'SEK' -%}
      {%- if section.settings.enable_header_promo_swe -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'AUD' -%}
      {%- if section.settings.enable_header_promo_aud -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
    {%- when 'NZD' -%}
      {%- if section.settings.enable_header_promo_nzd -%}
        {%- render 'header-promo', currency_code: currency_code, section: section -%}
      {%- endif -%}
  {%- endcase -%}
</div>

<script>
  const announcementBar = document.querySelector('.announcement-wrapper');
  const announcementBarHeight = announcementBar.offsetHeight;
  document.documentElement.style.setProperty('--announcement-bar-height', `${announcementBarHeight}px`);
</script>

