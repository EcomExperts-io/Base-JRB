          "options": [
            {
              "value": "300",
              "label": "t:sections.main-product.blocks.description.settings.description_font_weight.options__1.label"
            },
            {
              "value": "500",
              "label": "t:sections.main-product.blocks.description.settings.description_font_weight.options__2.label"
