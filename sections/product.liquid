<product-info
  data-url="{{ product.url}}"
  data-section="{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
>
  {{ 'component-product-price.css' | asset_url | stylesheet_tag }}
  {{ 'section-product.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.image_zoom != 'none' -%}
    {{ 'component-product-media-modal.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {% for block in section.blocks %}
    {% if block.type == 'complementary' %}
      {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
      {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'component-product-card.js' | asset_url }}" type="module"></script>
      <script src="{{ 'product-recommendations.js' | asset_url }}" type="module"></script>
      {% if block.settings.quick_add == 'standard' %}
        {{ 'component-quick-add.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'component-quick-add.js' | asset_url }}" type="module"></script>
        <script src="{{ 'component-modal-opener.js' | asset_url }}" type="module"></script>
      {% endif %}
    {% endif %}
  {% endfor %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    .option__label {
      font-size: {{ section.settings.variant_label_font_size }}px;
      font-weight: {{ section.settings.variant_label_font_weight }};
    }

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'title' %}
          .product__title h1 {
            font-size: {{ block.settings.title_font_size }}px;
            font-weight: {{ block.settings.title_font_weight }};
          }
        {% when 'description' %}
          .product__description {
            font-size: {{ block.settings.description_font_size }}px;
            font-weight: {{ block.settings.description_font_weight }};
          }
          .product__description a {
            color: rgb(var(--color-foreground));
          }
        {% when 'price' %}
          .price-item {
            font-size: {{ block.settings.price_font_size }}px;
            font-weight: {{ block.settings.price_font_weight }};
          }
      {% endcase %}
    {% endfor %}

    @media screen and (min-width: 769px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% assign selected_variant = product.selected_or_first_available_variant %}
  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  <!-- Data Layer -->
  <script type="application/json" data-product>
    {{ product | json }}
  </script>
  <!-- End Data Layer -->

  <!-- Variant Media Data (from variant metafields) -->
  <script type="application/json" id="variant-media-data-{{ section.id }}">
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "title": {{ variant.title | json }},
        "media": [
          {%- assign variant_custom_carousel = variant.metafields.custom.carousel_media -%}
          {%- assign variant_carousel = variant.metafields.carousel -%}
          {
            "src": "{{ variant.image | image_url: width: 600 }}",
            "srcset": "{{ variant.image | image_url: width: 1200 }}",
            "type": "image"
          }
          {%- if variant_custom_carousel -%}
            {%- for media in variant_custom_carousel.value -%}
              ,{
                {%- if media contains '/' or media.media_type == 'image' -%}
                  "src": "{{ media | image_url: width: 600 }}",
                  "srcset": "{{ media | image_url: width: 1200 }}",
                  "type": "image"
                {%- else -%}
                  "src": "{{ media.sources[1].url }}",
                  "srcset": "{{ media.url }}",
                  "type": "video",
                  "poster": "{{ media.preview_image | image_url: width: 1200 }}"
                {%- endif -%}
              }
            {%- endfor -%}
          {%- elsif variant_carousel.size > 0 -%}
            {%- for field in variant_carousel -%}
              {%- assign name = field | first -%}
              {%- assign media = variant_carousel[name].value -%}
              ,{
                {%- if media contains '/' or media.media_type == 'image' -%}
                  "src": "{{ media | image_url: width: 600 }}",
                  "srcset": "{{ media | image_url: width: 1200 }}",
                  "type": "image"
                {%- else -%}
                  "src": "{{ media.sources[1].url }}",
                  "srcset": "{{ media.url }}",
                  "type": "video",
                  "poster": "{{ media.preview_image | image_url: width: 1200 }}"
                {%- endif -%}
              }
            {%- endfor -%}
          {%- endif -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
  </script>
  <!-- End Variant Media Data -->

  <!-- Shade Descriptions (from variant metafields) -->
  <script type="application/json" id="shade-descriptions-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign shade_description = variant.metafields.findation_hero.description -%}
      {%- if shade_description != blank -%}
        {%- assign shade_position = product.options_by_name['Shade'].position -%}
        {%- assign shade_option_id = 'option' | append: shade_position -%}
        {%- assign shade_name = variant[shade_option_id] | downcase -%}
        {{ shade_name | json }}: {{ shade_description | json }}{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  }
  </script>
  <!-- End Shade Descriptions -->

  {%- if section.settings.enable_sticky_atc_bar -%}
    {% render 'component-product-sticky-bar',
      product: product,
      section: section,
      selected_variant: selected_variant
    %}
  {%- endif -%}

  <div class="page-width">
    <div class="product flex product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} {% if section.settings.constrain_to_viewport %}constrain-height{% endif %}">
      <div class="product__media-wrapper flex`__item media-{{ section.settings.media_fit }}">
        {% render 'component-product-media-gallery',
          product_media: product.media,
          selected_variant: selected_variant,
          video_looping: section.settings.enable_video_looping,
          is_zoom: section.settings.image_zoom,
          section_id: section.id,
          media_layout: section.settings.media_layout,
          mobile_media_layout: section.settings.mobile_media_layout
        %}

        {%- comment -%} How-to video below gallery {%- endcomment -%}
        {%- assign how_to_video = product.metafields.how_to.video -%}
        {%- assign how_to_video_external = product.metafields.how_to.external_video -%}
        {%- assign how_to_poster = product.metafields.how_to.poster -%}
        {%- if how_to_video != blank or how_to_video_external != blank -%}
          {% render 'component-product-how-to-video',
            how_to_video: how_to_video,
            how_to_video_external: how_to_video_external,
            how_to_poster: how_to_poster
          %}
        {%- endif -%}
      </div>
      <div class="product__info-wrapper flex__item {% if section.settings.enable_sticky_info %}product__info-sticky {% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <p
                class="product__text {% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </p>

            {%- when 'title' -%}
              <div class="product__title" {{ block.shopify_attributes }}>
                <h1>{{ product.title }}</h1>
              </div>
              {%- comment -%} Junip star rating + review count {%- endcomment -%}
              <div class="product__reviews">
                <span class="junip-product-summary" data-product-id="{{ product.id }}"></span>
              </div>

            {%- when 'price' -%}
              <div id="price-{{ section.id }}" class="product__price" role="status" {{ block.shopify_attributes }}>
                {%- render 'component-product-price',
                  product: product,
                  use_variant: true,
                  show_badges: true,
                  price_class: 'price--large'
                -%}
              </div>
              {%- if product.quantity_price_breaks_configured? -%}
                <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                  <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                </div>
              {%- endif -%}
              {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                <div class="product__tax caption rte">
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {{ 'products.product.duties_and_taxes_included' | t }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'products.product.taxes_included' | t }}
                  {%- elsif cart.duties_included -%}
                    {{ 'products.product.duties_included' | t }}
                  {%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>

            {%- when 'sku' -%}
              <p
                {{ block.shopify_attributes }}
                class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if selected_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                id="sku-{{ section.id }}"
              >
                {{- selected_variant.sku -}}
              </p>

            {%- when 'variant_picker' -%}
              <div class="product__variants" {{ block.shopify_attributes }}>
                {% unless product.has_only_default_variant %}
                  <variant-selector
                    id="variant-selector-{{ section.id }}"
                    data-picker-type="{{ block.settings.picker_type }}"
                  >
                    {%- if block.settings.picker_type == 'dropdown' -%}
                      <div class="variant-block__dropdown">
                        {% for option in product.options_with_values %}
                          <label class="option__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                            {{- option.name -}}
                          </label>
                          <fieldset class="product-form__input">
                            <select
                              name="options[{{ option.name | escape }}]"
                              id="Option-{{ section.id }}-{{ forloop.index0 }}"
                              form="{{ product_form_id }}"
                            >
                              {% for value in option.values %}
                                {%- capture input_id -%}
                                  {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
                                {%- endcapture -%}
                                <option
                                  id="{{ input_id }}"
                                  value="{{ value | escape }}"
                                  data-option-value-id="{{ value.id }}"
                                  data-product-url="{{ value.product_url }}"
                                  {% if value.selected %}
                                    selected="selected"
                                  {% endif %}
                                  {% unless value.available %}
                                    style="color: red; text-decoration: line-through;"
                                  {% endunless %}
                                >
                                  {{ value }}
                                  {% unless value.available %}
                                    Unavailable
                                  {% endunless %}
                                </option>
                              {% endfor %}
                            </select>
                          </fieldset>
                        {% endfor %}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.picker_type == 'button' -%}
                      <div class="variant-select__button">
                        {%- for option in product.options_with_values -%}
                          {%- assign option_name_downcase = option.name | downcase -%}
                          {%- if option_name_downcase == 'shade' or option_name_downcase == 'color' or option_name_downcase == 'colour' -%}
                            {%- comment -%} Shade category filter tabs {%- endcomment -%}
                            <div class="product__swatches-tabs" data-option-index="{{ forloop.index0 }}">
                              <ul class="product__swatches-tabs-wrapper">
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading active" data-tab="all">ALL</button></li>
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading" data-tab="fair">FAIR</button></li>
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading" data-tab="light">LIGHT</button></li>
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading" data-tab="medium">MEDIUM</button></li>
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading" data-tab="dark">DARK</button></li>
                                <li><button type="button" class="product__swatches-btn js-swatchesTabHeading" data-tab="deep">DEEP</button></li>
                              </ul>
                            </div>

                            {%- comment -%} Color swatch circles {%- endcomment -%}
                            {%- assign swatches_list = settings.swatches | newline_to_br | split: '<br />' -%}
                            <fieldset class="product-form__input product-form__input--swatches">
                              <div class="product__form-swatches">
                                {%- for value in option.values -%}
                                  {%- assign value_downcase = value | downcase -%}

                                  {%- comment -%} Find the variant matching this option value to read metafields {%- endcomment -%}
                                  {%- assign swatch_variant = nil -%}
                                  {%- assign option_id_key = 'option' | append: option.position -%}
                                  {%- for variant in product.variants -%}
                                    {%- if variant[option_id_key] == value -%}
                                      {%- assign swatch_variant = variant -%}
                                      {%- break -%}
                                    {%- endif -%}
                                  {%- endfor -%}

                                  {%- comment -%} Determine swatch display: metafield image > metafield color > global swatches > hardcoded fallback {%- endcomment -%}
                                  {%- assign swatch_color = '' -%}
                                  {%- assign swatch_image_url = '' -%}
                                  {%- assign swatch_use_image = false -%}

                                  {%- if swatch_variant -%}
                                    {%- if swatch_variant.metafields.swatch.image != blank -%}
                                      {%- assign swatch_image_url = swatch_variant.metafields.swatch.image | image_url: width: 100, height: 100 -%}
                                      {%- assign swatch_use_image = true -%}
                                    {%- elsif swatch_variant.metafields.swatch.color != blank -%}
                                      {%- assign swatch_color = swatch_variant.metafields.swatch.color -%}
                                    {%- endif -%}
                                  {%- endif -%}

                                  {%- comment -%} Fallback: check global swatches setting {%- endcomment -%}
                                  {%- if swatch_use_image == false and swatch_color == '' -%}
                                    {%- for s in swatches_list -%}
                                      {%- assign swatch_pair = s | split: '==' -%}
                                      {%- assign swatch_pair_name = swatch_pair | first | strip -%}
                                      {%- assign swatch_pair_value = swatch_pair | last | strip -%}
                                      {%- if swatch_pair_name == value -%}
                                        {%- if swatch_pair_value contains '.' or swatch_pair_value contains '//' -%}
                                          {%- assign swatch_image_url = swatch_pair_value -%}
                                          {%- assign swatch_use_image = true -%}
                                        {%- else -%}
                                          {%- assign swatch_color = swatch_pair_value -%}
                                        {%- endif -%}
                                        {%- break -%}
                                      {%- endif -%}
                                    {%- endfor -%}
                                  {%- endif -%}

                                  {%- comment -%} Last resort: hardcoded fallbacks for known WTF shades {%- endcomment -%}
                                  {%- if swatch_use_image == false and swatch_color == '' -%}
                                    {%- case value_downcase -%}
                                      {%- when 'alabaster' -%}{%- assign swatch_color = '#F5E1D0' -%}
                                      {%- when 'porcelain' -%}{%- assign swatch_color = '#EFCFAB' -%}
                                      {%- when 'fair' -%}{%- assign swatch_color = '#E8C8A0' -%}
                                      {%- when 'ivory' -%}{%- assign swatch_color = '#DEB88A' -%}
                                      {%- when 'light' -%}{%- assign swatch_color = '#D4AA78' -%}
                                      {%- when 'beige' -%}{%- assign swatch_color = '#C9A06C' -%}
                                      {%- when 'medium' -%}{%- assign swatch_color = '#BE9660' -%}
                                      {%- when 'medium honey' -%}{%- assign swatch_color = '#B38B55' -%}
                                      {%- when 'honey' -%}{%- assign swatch_color = '#A67D45' -%}
                                      {%- when 'golden' -%}{%- assign swatch_color = '#9A7239' -%}
                                      {%- when 'pecan' -%}{%- assign swatch_color = '#8D6530' -%}
                                      {%- when 'almond' -%}{%- assign swatch_color = '#7D5628' -%}
                                      {%- when 'cinnamon' -%}{%- assign swatch_color = '#6B4722' -%}
                                      {%- when 'chestnut' -%}{%- assign swatch_color = '#5A3A1C' -%}
                                      {%- when 'deep' -%}{%- assign swatch_color = '#4A2E16' -%}
                                      {%- when 'espresso' -%}{%- assign swatch_color = '#3A2410' -%}
                                      {%- else -%}{%- assign swatch_color = '#CCCCCC' -%}
                                    {%- endcase -%}
                                  {%- endif -%}

                                  {%- comment -%} Assign shade category for tab filtering {%- endcomment -%}
                                  {%- assign shade_category = 'all' -%}
                                  {%- if swatch_variant and swatch_variant.metafields.custom.shade_category != blank -%}
                                    {%- assign shade_category = swatch_variant.metafields.custom.shade_category -%}
                                  {%- else -%}
                                    {%- case value_downcase -%}
                                      {%- when 'alabaster' or 'porcelain' or 'fair' or 'ivory' -%}
                                        {%- assign shade_category = 'fair' -%}
                                      {%- when 'light' or 'beige' -%}
                                        {%- assign shade_category = 'light' -%}
                                      {%- when 'medium' or 'medium honey' or 'honey' or 'golden' -%}
                                        {%- assign shade_category = 'medium' -%}
                                      {%- when 'pecan' or 'almond' or 'cinnamon' or 'chestnut' -%}
                                        {%- assign shade_category = 'dark' -%}
                                      {%- when 'deep' or 'espresso' -%}
                                        {%- assign shade_category = 'deep' -%}
                                    {%- endcase -%}
                                  {%- endif -%}

                                  <div class="product__form-swatch" data-shade-category="{{ shade_category }}">
                                    <input
                                      type="radio"
                                      id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                      name="{{ option.name }}-{{ option.position }}"
                                      form="{{ product_form_id }}"
                                      value="{{ value | escape }}"
                                      class="swatch-radio visually-hidden {% unless value.available %}disabled{% endunless %}"
                                      {% if value.selected %}
                                        checked
                                      {% endif %}
                                      data-product-url="{{ value.product_url }}"
                                      data-option-value-id="{{ value.id }}"
                                    >
                                    <label
                                      class="swatch-label {% if block.settings.swatch_shape == 'circle' %}swatch-label--circle{% else %}swatch-label--square{% endif %} {% unless value.available %}swatch-disabled{% endunless %}"
                                      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                      {% if swatch_use_image %}
                                        style="background-image: url('{{ swatch_image_url }}'); background-size: cover; background-position: center;"
                                      {% else %}
                                        style="background-color: {{ swatch_color }};"
                                      {% endif %}
                                      title="{{ value }}"
                                    >
                                      <span class="visually-hidden">{{ value }}</span>
                                    </label>
                                  </div>
                                {%- endfor -%}
                              </div>
                            </fieldset>

                            {%- comment -%} Shade description {%- endcomment -%}
                            <div class="product__shade-info" id="shade-info-{{ section.id }}">
                              <span class="product__shade-name">{{ selected_variant.title | split: ' / ' | first }}</span>
                              <span class="product__shade-description" id="shade-description-{{ section.id }}">{{ selected_variant.metafields.findation_hero.description }}</span>
                            </div>

                            {%- comment -%} Find my Shade link {%- endcomment -%}
                            <a href="/pages/what-the-foundation-quiz" class="product__find-shade-link">Find my Shade</a>

                          {%- else -%}
                            {%- comment -%} Regular pill buttons for non-shade options {%- endcomment -%}
                            <fieldset class="product-form__input">
                              <legend class="option__label">{{ option.name }}</legend>
                              {%- for value in option.values -%}
                                <input
                                  type="radio"
                                  id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                  name="{{ option.name }}-{{ option.position }}"
                                  form="{{ product_form_id }}"
                                  value="{{ value | escape }}"
                                  class="pill-radio {% unless value.available %}disabled{% endunless %}"
                                  {% if value.selected %}
                                    checked
                                  {% endif %}
                                  data-product-url="{{ value.product_url }}"
                                  data-option-value-id="{{ value.id }}"
                                >
                                <label
                                  class="pill-label {% unless value.available %}pill-disabled{% endunless %}"
                                  for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                >
                                  {{ value }}
                                </label>
                              {%- endfor -%}
                            </fieldset>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    <script type="application/json" data-selected-variant>
                      {{ selected_variant | json }}
                    </script>
                  </variant-selector>
                {% endunless %}
              </div>

            {%- when 'quantity_selector' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label class="option__label" for="Quantity-{{ section.id }}">Quantity</label>
                <quantity-selector>
                  <button name="minus" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-minus" viewBox="0 0 10 2">
                      <path fill="currentColor" fill-rule="evenodd" d="M.5 1C.5.7.7.5 1 .5h8a.5.5 0 1 1 0 1H1A.5.5 0 0 1 .5 1" clip-rule="evenodd"></path>
                    </svg>
                  </button>
                  <input
                    id="Quantity-{{ section.id }}"
                    type="number"
                    name="quantity"
                    form="{{ product_form_id }}"
                    data-cart-quantity="{{ cart | item_count_for_variant: selected_variant.id }}"
                    min="{{ selected_variant.quantity_rule.min }}"
                    {% if selected_variant.quantity_rule.max != null %}
                      max="{{ selected_variant.quantity_rule.max }}"
                    {% endif %}
                    step="{{ selected_variant.quantity_rule.increment }}"
                    value="1"
                  >
                  <button name="plus" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-plus" viewBox="0 0 10 10">
                      <path fill="currentColor" fill-rule="evenodd" d="M1 4.51a.5.5 0 0 0 0 1h3.5l.01 3.5a.5.5 0 0 0 1-.01V5.5l3.5-.01a.5.5 0 0 0-.01-1H5.5L5.49.99a.5.5 0 0 0-1 .01v3.5l-3.5.01z" clip-rule="evenodd"></path>
                    </svg>
                  </button>
                </quantity-selector>
              </div>

            {%- when 'description' -%}
              {%- comment -%} Description is now rendered in the accordion section below {%- endcomment -%}

            {%- when 'buy_buttons' -%}
              <div class="product-form__buttons" {{ block.shopify_attributes }}>
                <ajax-cart-product-form>
                  {% form 'product', product, id: product_form_id, novalidate: 'novalidate' %}
                    <div data-ajax-cart-errors="form"></div>
                    <input type="hidden" name="id" value="{{ selected_variant.id }}">
                    <div id="add-to-cart-container-{{ section.id }}">
                      <button
                        id="AddToCart-{{ section.id }}"
                        type="submit"
                        name="add"
                        class="product__form-button {% if block.settings.show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
                        {% if selected_variant == null or selected_variant.available == false %}
                          disabled
                        {% endif %}
                      >
                        <span class="product__form-button__text">
                          {% if selected_variant == null %}
                            Unavailable
                          {% elsif selected_variant.available == false %}
                            Sold out
                          {% else %}
                            Add to cart
                          {% endif %}
                        </span>
                        <span class="product__form-price" id="product-form-price-{{ section.id }}">
                          {{ selected_variant.price | money }}
                        </span>
                        <span class="loading__spinner hidden">
                          {{ 'icon-spinner.svg' | inline_asset_content }}
                        </span>
                      </button>
                    </div>

                    {%- comment -%} Shipping & Returns badges {%- endcomment -%}
                    <div class="product__promises">
                      <div class="product__promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>Pay in 2 interest-free installments of <strong>{{ selected_variant.price | divided_by: 2 | money }}</strong> with <strong>shop</strong><svg xmlns="http://www.w3.org/2000/svg" width="40" height="16" viewBox="0 0 40 16" class="shop-pay-icon"><path fill="#5A31F4" d="M30.4 0H9.6C4.3 0 0 4.3 0 9.6v.8C0 11.7 4.3 16 9.6 16h20.8c5.3 0 9.6-4.3 9.6-9.6v-.8C40 4.3 35.7 0 30.4 0z"/><path fill="#fff" d="M13.2 4.8c-.7 0-1.3.2-1.7.7-.4.5-.6 1.1-.6 1.9 0 .8.2 1.4.6 1.9.4.5 1 .7 1.7.7.7 0 1.3-.2 1.7-.7.4-.5.6-1.1.6-1.9 0-.8-.2-1.4-.6-1.9-.4-.5-1-.7-1.7-.7z"/></svg> <a href="#" class="shop-pay-learn-more">Learn more</a></span>
                      </div>
                      <div class="product__promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        <span>Free shipping on US orders over $55</span>
                      </div>
                      <div class="product__promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Free & Easy Returns</span>
                      </div>
                    </div>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  {% endform %}
                </ajax-cart-product-form>

                {%- if block.settings.show_pickup_availability -%}
                  {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

                  {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
                    | where: 'pick_up_enabled', true
                  -%}

                  <pickup-availability
                    class="product__pickup-availabilities quick-add-hidden"
                    {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
                      available
                    {% endif %}
                    data-root-url="{{ routes.root_url }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-has-only-default-variant="{{ product.has_only_default_variant }}"
                    data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
                  >
                    <template>
                      <pickup-availability-preview class="pickup-availability-preview">
                        <span class="svg-wrapper">
                          {{- 'icon-unavailable.svg' | inline_asset_content -}}
                        </span>
                        <div class="pickup-availability-info">
                          <p class="caption-large">
                            {{ 'sections.main-product.blocks.pickup_availability.unavailable' | t }}
                          </p>
                          <button class="pickup-availability-button link link--text underlined-link">
                            {{ 'sections.main-product.blocks.pickup_availability.refresh' | t }}
                          </button>
                        </div>
                      </pickup-availability-preview>
                    </template>
                  </pickup-availability>

                  <script src="{{ 'component-pickup-availability.js' | asset_url }}" type="module"></script>
                {%- endif -%}
              </div>

            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}

            {%- when 'collapsible_tab' -%}
              <div class="product__accordion accordion" {{ block.shopify_attributes }}>
                <details>
                  <summary>
                    <div class="summary__title">
                      {%- if block.settings.icon != 'none' -%}
                        {%- assign file = block.settings.icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' -%}
                        <span class="svg-wrapper">{{ file | inline_asset_content }}</span>
                      {%- endif -%}
                      <h2 class="accordion__title">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </h2>
                    </div>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div class="accordion__content">
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              </div>
            {%- when 'inventory' -%}
              <p
                class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if selected_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                id="inventory-{{ section.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if selected_variant.inventory_management == 'shopify' -%}
                  {%- if selected_variant.inventory_quantity > 0 -%}
                    {%- if selected_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                      <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                        {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                      </span>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{- 'products.product.inventory_low_stock_show_count' | t: quantity: selected_variant.inventory_quantity -}}
                      {%- else -%}
                        {{- 'products.product.inventory_low_stock' | t -}}
                      {%- endif -%}
                    {%- else -%}
                      <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                        {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                      </span>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{- 'products.product.inventory_in_stock_show_count' | t: quantity: selected_variant.inventory_quantity -}}
                      {%- else -%}
                        {{- 'products.product.inventory_in_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- else -%}
                    {%- if selected_variant.inventory_policy == 'continue' -%}
                      <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                        {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                      </span>
                      {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                    {%- else -%}
                      <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                        {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                      </span>
                      {{- 'products.product.inventory_out_of_stock' | t -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- when 'share' -%}
              {% assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin %}
              {{ 'component-product-share-button.css' | asset_url | stylesheet_tag }}
              {% render 'component-product-share-button', block: block, share_link: share_url, section_id: section.id %}
              <script src="{{ 'component-product-share-button.js' | asset_url }}" type="module"></script>
            {%- when 'subscription' -%}
              <div class="product__subscription">
                {%- assign current_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
                {% if product.selling_plan_groups.size > 0 %}
                  <script src="{{ 'component-selling-plans.js' | asset_url }}" type="module"></script>
                  <selling-plans-widget data-section-id="{{ section.id }}" {{ block.shopify_attributes }}>
                    {% for variant in product.variants %}
                      {% liquid
                        assign variant_price = variant.price | money_with_currency | escape
                        assign variant_compared_at_price = variant.compare_at_price | money_with_currency | escape
                      %}
                      {% if variant.selling_plan_allocations.size > 0 %}
                        <div
                          data-variant-id="{{ variant.id }}"
                          class="selling_plan_theme_integration {% if variant.id != current_variant.id %}selling_plan_theme_integration--hidden{% endif %}"
                        >
                          <fieldset>
                            <legend>
                              {{ block.settings.supporting_text_title }}
                            </legend>
                            <div class="selling_options_container {% unless product.requires_selling_plan == false %}selling_options_container--no-one-time{% endunless %}">
                              {% unless product.requires_selling_plan %}
                                <div>
                                  <label>
                                    <input
                                      aria-label="One-time purchase. Product price {{ variant_price }}"
                                      type="radio"
                                      name="purchaseOption_{{ section.id }}_{{ variant.id }}"
                                      {% if variant.available == false %}
                                        disabled
                                      {% endif %}
                                      id="{{ section.id }}_one_time_purchase"
                                      data-radio-type="one_time_purchase"
                                      data-variant-id="{{ variant.id }}"
                                      data-variant-price="{{ variant_price }}"
                                      data-variant-compare-at-price="{{ variant_compared_at_price }}"
                                      checked
                                    >
                                    One-time purchase
                                  </label>
                                </div>
                              {% endunless %}
                              {% assign group_ids = variant.selling_plan_allocations | map: 'selling_plan_group_id' | uniq %}
                              {% for group_id in group_ids %}
                                {% liquid
                                  assign group = product | map: 'selling_plan_groups' | where: 'id', group_id | first
                                  assign allocations = variant | map: 'selling_plan_allocations' | where: 'selling_plan_group_id', group_id
                                  if forloop.first
                                    assign first_selling_plan_group = true
                                  else
                                    assign first_selling_plan_group = false
                                  endif
                                %}
                                <hr>
                                <div>
                                  <div>
                                    <label>{{ group.name }}</label>
                                  </div>
                                  <ul>
                                    {% for allocation in allocations %}
                                      {% liquid
                                        if forloop.first and product.requires_selling_plan and first_selling_plan_group
                                          assign plan_checked = 'checked'
                                        else
                                          assign plan_checked = null
                                        endif
                                        assign allocation_price = allocation.price | money_with_currency | escape
                                        assign allocation_compared_at_price = allocation.compare_at_price | money_with_currency | escape
                                      %}
                                      <li>
                                        <label>
                                          <input
                                            type="radio"
                                            {% if variant.available == false %}
                                              disabled
                                            {% endif %}
                                            aria-label="{{ allocation.selling_plan.name }}. Product price {{ allocation_price }}"
                                            name="purchaseOption_{{ section.id }}_{{ variant.id }}"
                                            data-radio-type="selling_plan"
                                            data-selling-plan-id="{{ allocation.selling_plan.id }}"
                                            data-selling-plan-group-id="{{ section.id }}_{{ group_id }}_{{ variant.id }}"
                                            data-selling-plan-adjustment="{{ allocation.selling_plan.price_adjustments.size }}"
                                            data-variant-price="{{ allocation_price }}"
                                            data-variant-compare-at-price="{{ allocation_compared_at_price }}"
                                            {{ plan_checked }}
                                          >
                                          {{ allocation.selling_plan.name }}
                                        </label>
                                      </li>
                                    {% endfor %}
                                  </ul>
                                </div>
                              {% endfor %}
                            </div>
                          </fieldset>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </selling-plans-widget>
                  <input
                    name="selling_plan"
                    class="selected-selling-plan-id"
                    type="hidden"
                  >
                {% endif %}
              </div>
            {%- when 'complementary' -%}
              <product-recommendations
                {{ block.shopify_attributes }}
                class="product-recommendations-container"
                data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.products_to_show }}&intent=complementary"
              >
                {% if recommendations.performed and recommendations.products_count > 0 %}
                  <h2 class="complementary-products-heading">{{ block.settings.heading }}</h2>
                  <div class="product-recommendations-list">
                    {%- for product in recommendations.products limit: block.settings.products_to_show -%}
                      <div class="product-recommendations-item">
                        {% render 'component-product-card',
                          card_product: product,
                          show_vendor: block.settings.show_vendor,
                          enable_swatches: block.settings.enable_swatches,
                          swatch_trigger: block.settings.swatch_trigger,
                          swatch_type: block.settings.swatch_type,
                          quick_add: block.settings.quick_add,
                          section_id: section.id,
                          button_text_color: block.settings.button_text_color,
                          button_border_color: block.settings.button_border_color
                        %}
                      </div>
                    {%- endfor -%}
                  </div>
                {% endif %}
              </product-recommendations>
          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%} Videowise "As Seen On You" UGC widget {%- endcomment -%}
        {%- if section.settings.videowise_code != blank -%}
          <div class="product__description-videowise">
            {{ section.settings.videowise_code }}
          </div>
        {%- endif -%}

        {%- comment -%} Product description accordions (Shade Descriptions, How to Use, Ingredients, Pair With) {%- endcomment -%}
        {% render 'component-product-accordions',
          product: product,
          selected_variant: product.selected_or_first_available_variant,
          section_id: section.id
        %}
      </div>
    </div>
  </div>
  {%- if section.settings.image_zoom != 'none' -%}
    {% render 'component-product-media-modal',
      section_id: section.id,
      color_scheme: section.settings.color_scheme,
      enable_video_looping: section.settings.enable_video_looping
    %}
  {%- endif -%}

  <script src="{{ 'section-product.js' | asset_url }}" type="module"></script>

  {%- if section.settings.image_zoom != 'none' -%}
    <script src="{{ 'component-product-media-modal.js' | asset_url }}" type="module"></script>
  {%- endif -%}

  {%- if section.settings.image_zoom == 'hover' -%}
    <script src="{{ 'component-product-media-magnify.js' | asset_url }}" type="module"></script>
  {%- endif -%}
</product-info>

{% schema %}
