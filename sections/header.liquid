    height: 2px;
    position: relative;
  }
  button.header-drawer_icons svg {
    display: none !important;
  }
  button.header-drawer_icons:after, 
  button.header-drawer_icons:before {
    background: #000;
    content: "";
    left: 0;
    right: 0;
    transition: all .4s cubic-bezier(.165, .84, .44, 1);
    height: 2px;
    position: absolute;
    width: 28px;
  }
  button.header-drawer_icons:before {
    bottom: -3px;
  }
  button.header-drawer_icons:after {
    top: -3px;
  }
  button.header-drawer_icons.drawer-open:before {
    bottom: 0;
    transform: rotate(45deg);
  }
  button.header-drawer_icons.drawer-open:after {
    top: 0;
    transform: rotate(-45deg);
  }
}




